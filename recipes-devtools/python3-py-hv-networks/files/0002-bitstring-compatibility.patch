From 58fa4923f03b224e75402434f0c8cd7b3cd1a1b1 Mon Sep 17 00:00:00 2001
From: Gemini <gemini@tcat.org>
Date: Tue, 7 Apr 2026 00:00:00 +0000
Subject: [PATCH] fix bitstring compatibility

Replace deprecated ConstBitArray with Bits for bitstring version >= 4.0.0.
---
 j1708dump.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/j1708dump.py b/j1708dump.py
index a1a1a1a..b1b1b1b 100755
--- a/j1708dump.py
+++ b/j1708dump.py
@@ -91,7 +91,7 @@ def get_filter_val_and_mask(phil):
 
 def is_filter_applies(phil, messagebits):
     (val, mask) = get_filter_val_and_mask(phil)
-    mask = bitstring.ConstBitArray(hex=mask)
+    mask = bitstring.Bits(hex=mask)
     masklen = mask.len
     testmessage = messagebits[:masklen]
     return (testmessage & mask[: testmessage.len]).hex == val
@@ -150,7 +150,7 @@ def main():
             skip_this_message = True
 
             if messagebits is None:
-                messagebits = bitstring.ConstBitArray(message)
+                messagebits = bitstring.Bits(message)
             for phil in args.show:
                 if is_filter_applies(phil, messagebits):
                     skip_this_message = False
@@ -158,7 +158,7 @@ def main():
 
         if args.hide is not None:
             if messagebits is None:
-                messagebits = bitstring.ConstBitArray(message)
+                messagebits = bitstring.Bits(message)
             for phil in args.hide:
                 if is_filter_applies(phil, messagebits):
                     skip_this_message = True
@@ -168,7 +168,7 @@ def main():
             continue
 
         if messagebits is None:
-            messagebits = bitstring.ConstBitArray(message)
+            messagebits = bitstring.Bits(message)
         if messagebits.len < 8:
             sys.stderr.write('short frame "%s"\n' % messagebits)
             continue
-- 
