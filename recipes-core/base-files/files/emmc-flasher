#!/bin/bash -e
source='mmcblk0'
destination='mmcblk1'

# fancy color codes
BLUE='\033[1;34m'
NC='\033[0m' # no color
RED='\033[1;31m'

# helper functions
flush_cache () {
    sync
    blockdev --flushbufs /dev/${destination}
}

cylon_leds () {
    if [ -e /sys/class/leds/beaglebone\:green\:usr0/trigger ] ; then
        BASE=/sys/class/leds/beaglebone\:green\:usr
        echo none > ${BASE}0/trigger
        echo none > ${BASE}1/trigger
        echo none > ${BASE}2/trigger
        echo none > ${BASE}3/trigger

        STATE=1
        while : ; do
            case $STATE in
            1)	echo 255 > ${BASE}0/brightness
                echo 0   > ${BASE}1/brightness
                STATE=2
                ;;
            2)	echo 255 > ${BASE}1/brightness
                echo 0   > ${BASE}0/brightness
                STATE=3
                ;;
            3)	echo 255 > ${BASE}2/brightness
                echo 0   > ${BASE}1/brightness
                STATE=4
                ;;
            4)	echo 255 > ${BASE}3/brightness
                echo 0   > ${BASE}2/brightness
                STATE=5
                ;;
            5)	echo 255 > ${BASE}2/brightness
                echo 0   > ${BASE}3/brightness
                STATE=6
                ;;
            6)	echo 255 > ${BASE}1/brightness
                echo 0   > ${BASE}2/brightness
                STATE=1
                ;;
            *)	echo 255 > ${BASE}0/brightness
                echo 0   > ${BASE}1/brightness
                STATE=2
                ;;
            esac
            sleep 0.1
        done
    fi
}

partition_drive () {
fdisk /dev/${destination} << EOM
o
p
n
p
1
2048
+128M
y
t
c
a
1
n
p
2


y
p
w
EOM

flush_cache
}

write_failure () {
    echo -e "${RED}writing to [${destination}] failed...${NC}"

    [ -e /proc/$CYLON_PID ]  && kill $CYLON_PID > /dev/null 2>&1

    if [ -e /sys/class/leds/beaglebone\:green\:usr0/trigger ] ; then
        echo heartbeat > /sys/class/leds/beaglebone\:green\:usr0/trigger
        echo heartbeat > /sys/class/leds/beaglebone\:green\:usr1/trigger
        echo heartbeat > /sys/class/leds/beaglebone\:green\:usr2/trigger
        echo heartbeat > /sys/class/leds/beaglebone\:green\:usr3/trigger
    fi
    echo -e "${RED}-----------------------------${NC}"
    flush_cache
    umount /mnt/${destination}p1 || true
    umount /mnt/${destination}p2 || true
    umount /mnt/${source}p1 || true
    umount /mnt/${source}p2 || true
    exit
}

format_partitions () {
    # Format the first partition
    echo -e "${BLUE}Formatting first partition${NC}"
    umount /dev/${destination}p1 || true; echo 'y' | mkfs.vfat -F 32 /dev/${destination}p1; flush_cache

    # Format the second partition
    echo -e "${BLUE}Formatting second partition${NC}"
    umount /dev/${destination}p2 || true; echo 'y' | mkfs.ext4 /dev/${destination}p2; flush_cache
}

copy_partitions () {
    # Prepare the system to copy partitions
    mkdir -p /mnt/${destination}p1
    mount /dev/${destination}p1 /mnt/${destination}p1 || write_failure
    mkdir -p /mnt/${destination}p2
    mount /dev/${destination}p2 /mnt/${destination}p2 || write_failure
    mkdir -p /mnt/${source}p1
    mount /dev/${source}p1 /mnt/${source}p1 || write_failure
    mkdir -p /mnt/${source}p2
    mount /dev/${source}p2 /mnt/${source}p2 || write_failure

    # Make sure the BootLoader gets copied first:
    cp -v /mnt/${source}p1/MLO /mnt/${destination}p1/MLO || write_failure
    flush_cache

    cp -v /mnt/${source}p1/u-boot.img /mnt/${destination}p1/u-boot.img || write_failure
    flush_cache

    echo -e "${BLUE}rsync: /mnt/${source}p1/ -> /mnt/${destination}p1/${NC}"
    rsync -aAX /mnt/${source}p1/ /mnt/${destination}p1/ --exclude={MLO,u-boot.img} || write_failure
    flush_cache

    echo -e "${BLUE}rsync: /mnt/${source}p2/ -> /mnt/${destination}p2/${NC}"
    rsync -aAX /mnt/${source}p2/ /mnt/${destination}p2/ --exclude={/dev/*,/proc/*,/sys/*,/tmp/*,/run/*,/mnt/*,/media/*,/lost+found} || write_failure
    flush_cache
}

regenerate_ssh_keys () {
    # Regenerate SSH keys
    echo -e "${BLUE}==> Applying SSH Key and machine-id Regeneration trick${NC}"
    # ssh keys and machine-id will now get regenerated on the next bootup
    touch /mnt/${destination}p2/etc/ssh/ssh.regenerate
    rm -f /mnt/${destination}p2/etc/machine-id || true
    flush_cache
}

cleanup () {
    # Cleanup
    umount /mnt/${source}p1
    umount /mnt/${source}p2
    rm -rf /mnt/${source}p1
    rm -rf /mnt/${source}p2
}

rename_host() {
    read -e -p "Enter the complete identifier for this board (e.g., UTHP-R1-XXXX, MyTruckDuck77, etc.) to be used for hostname:" SERIAL_NUMBER

    if [[ -z "$SERIAL_NUMBER" ]]; then
        echo -e "${RED}Error: Serial number cannot be empty.${NC}" >&2
        exit 1
    fi

    NEW_HOSTNAME="$SERIAL_NUMBER"

    # Update /etc/hostname on eMMC
    echo -e "${BLUE}Updating /etc/hostname to $NEW_HOSTNAME...${NC}"
    echo "$NEW_HOSTNAME" | sudo tee /mnt/${destination}p2/etc/hostname > /dev/null
    echo -e "${BLUE}Updated /etc/hostname.${NC}"

    # Update /etc/hosts on eMMC
    echo -e "${BLUE}Updating /etc/hosts...${NC}"

    # Ensure 127.0.1.1 entry is correctly set
    if grep -q "127.0.1.1" /mnt/${destination}p2/etc/hosts; then
        sudo sed -i "s/^127.0.1.1 .*/127.0.1.1 $NEW_HOSTNAME/" /mnt/${destination}p2/etc/hosts
    else
        echo "127.0.1.1 $NEW_HOSTNAME" | sudo tee -a /mnt/${destination}p2/etc/hosts > /dev/null
    fi

    # Ensure localhost entry exists
    if ! grep -q "127.0.0.1" /mnt/${destination}p2/etc/hosts; then
        echo "127.0.0.1 localhost" | sudo tee -a /mnt/${destination}p2/etc/hosts > /dev/null
    fi

    echo -e "${BLUE}Hostname updated successfully.${NC}"
}

# main
echo -e "${BLUE}==> START: eMMC Flasher${NC}"
# check if user has sudo privileges
if [ "$EUID" -ne 0 ]
    then echo -e "${RED}Please run as root${NC}"
         echo
         exit 1
fi
echo -e "${BLUE}==> Checking if script is running from the correct storage device.${NC}"
if df -h | grep -q "/dev/mmcblk1"; then
    echo -e "${RED}This script is intended to be run from a microSD card.${NC}"
    echo
    exit 1
fi
# always ensure the emmc is zerod out first

# update the time
echo -e "${BLUE}==> Updating Time${NC}"
if ! sudo update-time; then
    echo -e "${RED}Warning: Failed to update time. Time is not synchronized.${NC}"
fi

# erase emmc
echo -e "${BLUE}==> Erasing eMMC${NC}"
flush_cache
dd if=/dev/zero of=/dev/${destination} bs=1M count=108
sync
dd if=/dev/${destination} of=/dev/null bs=1M count=108
sync

# start leds
cylon_leds & CYLON_PID=$!
# flush cache
flush_cache
# partition emmc
echo -e "${BLUE}==> Partitioning eMMC${NC}"
partition_drive
# format partitions
echo -e "${BLUE}==> Formatting eMMC${NC}"
format_partitions
# copy partitions (this takes up a lot of time and CPU resources)
echo -e "${BLUE}==> Copying eMMC${NC}"
copy_partitions

# add user and post-production data on destination eMMC
echo -e "${BLUE}==> Generating Post-Production Image Data${NC}"
rename_host

echo -e "${BLUE}Creating user 'nmfta'...${NC}"
sudo chroot /mnt/${destination}p2 /bin/bash -c "
if id 'nmfta' &>/dev/null; then
    deluser nmfta
fi
useradd -m -d /home/nmfta -s /bin/bash nmfta
echo 'nmfta:$NEW_HOSTNAME' | chpasswd
usermod -aG sudo nmfta
passwd -l root
chown -R nmfta:nmfta /home/nmfta
"
echo -e "${BLUE}==> User 'nmfta' added and root account locked${NC}"

# update-overlays on eMMC
if grep -q "FDTOVERLAYS" /mnt/${destination}p1/extlinux/extlinux.conf; then
    echo -e "${BLUE}==> Device Tree Overlays should already be updated on eMMC${NC}"
else
    echo -e "${BLUE}==> Updating Device Tree Overlays on eMMC${NC}"
    mkdir -p /mnt/${destination}p2/boot/p1
    mount /dev/${destination}p1 /mnt/${destination}p2/boot/p1
    sudo chroot /mnt/${destination}p2 /bin/bash -c "update-overlays"
    umount /mnt/${destination}p2/boot/p1
fi

# regenerate ssh keys
echo -e "${BLUE}==> Regenerating SSH keys${NC}"
regenerate_ssh_keys
# regenerate fstab
echo -e "${BLUE}==> Regenerating fstab${NC}"
sed -i "s/${source}/${destination}/g" /mnt/${destination}p2/etc/fstab
# cleanup
echo -e "${BLUE}==> Cleaning up${NC}"
cleanup
# stop leds
kill $CYLON_PID > /dev/null 2>&1
echo -e "${BLUE}==> eMMC Flashing Complete${NC}"
echo -e "${BLUE}==> END: Please power off your device, remove the SD card, and power it back on${NC}"
